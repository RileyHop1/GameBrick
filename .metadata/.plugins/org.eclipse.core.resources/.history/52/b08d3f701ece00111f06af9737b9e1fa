#include "board.h"

/* Button pins */
#define BTN_PA1_PIN        1U
#define BTN_PA2_PIN        2U
#define BTN_PA3_PIN        3U

#define BTN_PB0_PIN        0U
#define BTN_PB1_PIN        1U
#define BTN_PB2_PIN        2U

/* LCD control pins */
#define LCD_CS_PIN         4U
#define LCD_DC_PIN         6U
#define LCD_RESET_PIN      7U

/* Generic GPIO register fields */
#define GPIO_MODE_MASK(pin)        (3U << ((pin) * 2U))
#define GPIO_MODE_OUTPUT(pin)      (1U << ((pin) * 2U))
#define GPIO_PUPD_MASK(pin)        (3U << ((pin) * 2U))
#define GPIO_PUPD_PULLUP(pin)      (1U << ((pin) * 2U))
#define GPIO_PIN_SET(pin)          (1U << (pin))
#define BUTTON_GPIOA_MASK ( \
    GPIO_MODE_MASK(BTN_PA1_PIN) | \
    GPIO_MODE_MASK(BTN_PA2_PIN) | \
    GPIO_MODE_MASK(BTN_PA3_PIN) )
#define BUTTON_GPIOB_MASK ( \
    GPIO_MODE_MASK(BTN_PB0_PIN) | \
    GPIO_MODE_MASK(BTN_PB1_PIN) | \
    GPIO_MODE_MASK(BTN_PB2_PIN) )
#define BUTTON_GPIOA_PULLUP ( \
    GPIO_PUPD_PULLUP(BTN_PA1_PIN) | \
    GPIO_PUPD_PULLUP(BTN_PA2_PIN) | \
    GPIO_PUPD_PULLUP(BTN_PA3_PIN) )
#define BUTTON_GPIOB_PULLUP ( \
    GPIO_PUPD_PULLUP(BTN_PB0_PIN) | \
    GPIO_PUPD_PULLUP(BTN_PB1_PIN) | \
    GPIO_PUPD_PULLUP(BTN_PB2_PIN) )



static void gpio_button_init(void) {
    GPIOA->MODER &= ~BUTTON_GPIOA_MASK;
    GPIOB->MODER &= ~BUTTON_GPIOB_MASK;

    GPIOA->PUPDR &= ~BUTTON_GPIOA_MASK;
    GPIOA->PUPDR |=  BUTTON_GPIOA_PULLUP;

    GPIOB->PUPDR &= ~BUTTON_GPIOB_MASK;
    GPIOB->PUPDR |=  BUTTON_GPIOB_PULLUP;
}

static void gpio_lcd_init(void) {


	GPIOA->MODER &= ~(3U << (4 * 2));
	GPIOA->MODER |=  (1U << (4 * 2));

	GPIOB->MODER &= ~(
			(3U << (6 * 2))|
			(3U << (7 * 2))
	);

	GPIOB->MODER |= (
			(1U << (6 * 2))|
			(1U << (7 * 2))
	);

	//Set the inital state of the pins
	GPIOA->BSRR = (1U << 4);
	GPIOB->BSRR = (1U << 7);
}

static void spi1_lcd_init(void) {

}


int init_board(void) {

	gpio_button_init();
	gpio_lcd_init();
	spi1_lcd_init();


	return 0;

}
