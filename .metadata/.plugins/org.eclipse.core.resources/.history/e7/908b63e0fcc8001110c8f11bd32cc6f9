#include "board.h"



static void gpio_button_init(void) {

	//Enable the clocking for GPIO A and B
	RCC->AHB1ENR |= RCC_AHB1ENR_GPIOAEN;
	RCC->AHB1ENR |= RCC_AHB1ENR_GPIOBEN;

	GPIOA-> &= ~(
			(3U << (1 * 2)) |
			(3U << (2 * 2)) |
			(3U << (3 * 2)) |
	);


}

static void gpio_lcd_init(void) {

}

static void spi1_lcd_init(void) {

}


int init_board(void) {

	gpio_button_init();
	gpio_lcd_init();
	spi1_lcd_init();


	return 0;

}
