#include "board.h"



static void gpio_button_init(void) {

	//Enable the clocking for GPIO A and B
	RCC->AHB1ENR |= RCC_AHB1ENR_GPIOAEN;
	RCC->AHB1ENR |= RCC_AHB1ENR_GPIOBEN;

	GPIOA->MODER &= ~(
			(3U << (1 * 2)) |
			(3U << (2 * 2)) |
			(3U << (3 * 2))
	);

	GPIOB->MODER &= ~(
			(3U << (0 * 2)) |
			(3U << (1 * 2)) |
			(3U << (2 * 2))
	);



	//Configuring the pins as pull up since the buttons connected to ground
	GPIOA->PUPDR &= ~(
			(3U << (1 * 2)) |
			(3U << (2 * 2)) |
			(3U << (3 * 2))
	);

	GPIOA->PUPDR |= (
			(1U << (1 * 2)) |
			(1U << (2 * 2)) |
			(1U << (3 * 2))
	);

	GPIOB->PUPDR &= ~(
			(3U << (0 * 2)) |
			(3U << (1 * 2)) |
			(3U << (2 * 2))
	);

	GPIOB->PUPDR |= (
			(1U << (0 * 2)) |
			(1U << (1 * 2)) |
			(1U << (2 * 2))
	);


}

static void gpio_lcd_init(void) {


	GPIOA->MODER &= ~(3U << (4 * 2));
	GPIOA->MODER |=  (1U << (4 * 2));

	GPIOB->MODER &= ~(
			3U << (6 * 2)|
			3U << (7 * 2)
	);

	GPIOB->MODER |= (
			1U << (6 * 2)|
			1U << (7 * 2)
	);
}

static void spi1_lcd_init(void) {

}


int init_board(void) {

	gpio_button_init();
	gpio_lcd_init();
	spi1_lcd_init();


	return 0;

}
